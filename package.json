{
  "name": "chinese-info-gen-web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vp dev",
    "build": "vue-tsc --noEmit && vp build",
    "preview": "vp preview",
    "preinstall": "pnpx json5 package.json5 --out-file package.json --space 2",
    "check": "vp check && vue-tsc --noEmit",
    "check:fix": "vp check --fix && vue-tsc --noEmit",
    "deploy": "vp build && wrangler deploy"
  },
  "devDependencies": {
    "tailwindcss": "4.3.2",
    "tailwind-merge": "3.6.0",
    "@tailwindcss/vite": "4.3.2",
    "tailwindcss-primeui": "0.6.1",
    "clsx": "2.1.1",
    "tw-animate-css": "1.4.0",
    "primevue": "4.5.5",
    "@primevue/icons": "4.5.5",
    "primeicons": "7.0.0",
    "@tsconfig/node26": "26.0.0",
    "@types/node": "26.1.1",
    "@vue/tsconfig": "0.9.1",
    "typescript": "6",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "3.5.39",
    "vue-tsc": "3.3.7",
    "vite-plugin-vue-devtools": "8.1.5",
    "@vitejs/plugin-vue": "6.0.7",
    "@vueuse/core": "14.3.0",
    "vue-router": "5.1.0",
    "pinia": "3.0.4",
    "pinia-plugin-persistedstate": "4.7.1",
    "vue-draggable-plus": "0.6.1",
    "@iconify-json/mdi": "1.2.3",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "32.1.0",
    "dayjs": "1.11.21",
    "uuid": "14.0.1",
    "crypto-js": "4.2.0",
    "@types/crypto-js": "4.2.2",
    "qrcode": "1.5.4",
    "vue-sonner": "2.0.9",
    "@faker-js/faker": "10.4.0",
    "wrangler": "4.124.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  }
}